---
import LineIcon from "./LineIcon.astro";
const capabilities = [
  { icon: "code", label: "Desarrollo web" },
  { icon: "layers", label: "Aplicaciones a medida" },
  { icon: "bot", label: "Herramientas con IA" },
  { icon: "cloud", label: "Infraestructura y despliegue" },
] as const;
const iconBase = "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons";
const stackGroups = [
  {
    title: "Frontend",
    technologies: [
      ["astro/astro-original.svg", "Astro"],
      ["react/react-original.svg", "React"],
      ["typescript/typescript-original.svg", "TypeScript"],
      ["javascript/javascript-original.svg", "JavaScript"],
      ["tailwindcss/tailwindcss-original.svg", "Tailwind"],
      ["html5/html5-original.svg", "HTML"],
      ["css3/css3-original.svg", "CSS"],
    ],
  },
  {
    title: "Backend & Datos",
    technologies: [
      ["nodejs/nodejs-original.svg", "Node.js"],
      ["express/express-original.svg", "Express"],
      ["mongodb/mongodb-original.svg", "MongoDB"],
      ["mysql/mysql-original.svg", "MySQL"],
      ["php/php-original.svg", "PHP"],
    ],
  },
  {
    title: "Cloud & Herramientas",
    technologies: [
      ["amazonwebservices/amazonwebservices-original-wordmark.svg", "AWS"],
      ["git/git-original.svg", "Git"],
      ["github/github-original.svg", "GitHub"],
      ["linux/linux-original.svg", "Linux"],
      ["vscode/vscode-original.svg", "VS Code"],
    ],
  },
  {
    title: "También he trabajado con",
    technologies: [
      ["vuejs/vuejs-original.svg", "Vue"],
      ["angular/angular-original.svg", "Angular"],
      ["ionic/ionic-original.svg", "Ionic"],
    ],
  },
];
---

<section id="sobre-mi" class="scroll-mt-16 border-b border-white/8 py-8">
  <div
    class="mx-auto grid max-w-375 gap-8 px-5 sm:px-8 lg:grid-cols-[.85fr_1.15fr_.48fr] lg:px-12"
  >
    <div>
      <div class="panel-heading">
        <LineIcon name="code" class="size-4" /><h2>Sobre mí</h2>
      </div><p class="mt-3 text-sm leading-6 text-slate-300">
        Soy desarrolladora Full Stack y creo aplicaciones web a medida, desde el
        diseño y la base de datos hasta el servidor. Tengo experiencia creando
        paneles de gestión, CMS multilingües y herramientas integradas con
        inteligencia artificial.
      </p><ul class="mt-3 text-sm leading-6 text-slate-400">
        <li class="flex gap-2"><span class="text-cyan-300" aria-hidden="true">•</span><span><strong class="font-semibold text-slate-200">Me encargo de todo el proceso:</strong> programar la solución, configurar la infraestructura y dejarla funcionando en producción.</span></li>
      </ul><div class="mt-4 grid grid-cols-2 gap-2">
        {
          capabilities.map((capability) => (
            <div class="flex items-center gap-2 rounded border border-white/7 bg-white/2 px-3 py-2.5">
              <>
                <LineIcon
                  name={capability.icon}
                  class="size-5 shrink-0 text-cyan-300"
                />
                <span class="text-[11px] leading-4 text-slate-300">
                  {capability.label}
                </span>
              </>
            </div>
          ))
        }
      </div>
    </div>
    <div>
      <div class="panel-heading">
        <LineIcon name="layers" class="size-4" /><h2>Stack tecnológico</h2>
      </div><div class="mt-3 grid gap-2">
        {
          stackGroups.map((group) => (
            <div class="grid items-center gap-2 sm:grid-cols-[155px_1fr]">
              <>
                <p class="rounded bg-white/4 px-3 py-3 text-xs font-semibold text-slate-200">
                  {group.title}
                </p>
                <div class="flex flex-wrap gap-2">
                  {group.technologies.map(([path, name]) => (
                    <div
                      class="group relative grid size-9 place-items-center rounded border border-white/7 bg-[#0b1723] p-1.5"
                      title={name}
                    >
                      <img
                        src={`${iconBase}/${path}`}
                        alt={name}
                        width="24"
                        height="24"
                        loading="lazy"
                        class:list={[
                          "size-6 object-contain",
                          ["Express", "GitHub"].includes(name) &&
                            "rounded bg-white p-0.5",
                        ]}
                      />
                      <span class="pointer-events-none absolute top-full z-10 mt-1 hidden whitespace-nowrap rounded bg-slate-900 px-2 py-1 text-[9px] text-white group-hover:block">
                        {name}
                      </span>
                    </div>
                  ))}
                </div>
              </>
            </div>
          ))
        }
      </div>
    </div>
    <aside class="hidden items-center border-l border-white/10 pl-7 lg:flex">
      <blockquote class="text-base leading-7 text-slate-400">
        <span class="mb-3 block font-serif text-4xl leading-none text-slate-600"
          >“</span
        >Disfruto aprendiendo,<br />resolviendo problemas<br />y convirtiendo
        ideas<br />en proyectos reales.
      </blockquote>
    </aside>
  </div>
</section>
