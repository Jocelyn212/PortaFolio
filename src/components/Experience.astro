---
import { education } from "../data/profile";
import LineIcon from "./LineIcon.astro";
---

<section
  id="trayectoria"
  class="scroll-mt-16 border-b border-white/8 bg-white/1.5 py-8"
>
  <div class="mx-auto max-w-375 px-5 sm:px-8 lg:px-12">
    <div class="panel-heading mb-5">
      <LineIcon name="briefcase" class="size-4" /><h2>
        Experiencia y formación
      </h2>
    </div>
    <div class="grid gap-8 lg:grid-cols-[.62fr_1.38fr]">
      <div>
        <p
          class="mb-3 font-mono text-[10px] uppercase tracking-[.18em] text-cyan-300"
        >
          Experiencia
        </p>
        <div class="relative border-l border-cyan-400/30 pl-5">
          <span
            class="absolute -left-1 top-1 size-2 rounded-full bg-cyan-300 shadow-[0_0_10px_rgba(34,211,238,.45)]"
          ></span><div
            class="flex flex-wrap items-baseline justify-between gap-2 border-b border-white/8 pb-2"
          >
            <h3 class="text-sm font-semibold text-white">JCTechStudio</h3><time
              class="font-mono text-[10px] text-cyan-300"
              >2024 — Actualidad</time>
          </div><p class="mt-3 text-xs leading-5 text-slate-400">
            Desarrollo de sitios y aplicaciones web, herramientas digitales y
            soluciones a medida, incluyendo frontend, backend, integraciones y
            despliegue en producción.
          </p>
        </div>
      </div>
      <div>
        <p
          class="mb-3 font-mono text-[10px] uppercase tracking-[.18em] text-cyan-300"
        >
          Formación
        </p>
        <ol class="grid gap-x-7 sm:grid-cols-2">
          {
            education.map((item, index) => (
              <li class="relative grid grid-cols-[24px_1fr] gap-2 border-t border-white/8 py-3 first:border-t-0 sm:nth-2:border-t-0">
                <>
                  <span class="font-mono text-[9px] text-slate-600">
                    0{index + 1}
                  </span>
                  <div>
                    <>
                      <div class="flex items-start justify-between gap-3">
                        <>
                          <h3 class="text-xs font-semibold leading-5 text-white">
                            {item.program}
                          </h3>
                          <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-cyan-400" />
                        </>
                      </div>
                      <p class="mt-0.5 text-[11px] text-slate-400">
                        {item.institution}
                      </p>
                      <p class="mt-1.5 font-mono text-[9px] text-slate-500">
                        {item.detail}
                      </p>
                    </>
                  </div>
                </>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>
