---
import { clientProjects, featuredProjects } from "../data/projects";
import LineIcon from "./LineIcon.astro";
const allProjects = [...featuredProjects, ...clientProjects];
---

<section id="proyectos" class="scroll-mt-16 border-b border-white/8 py-9">
  <div class="mx-auto max-w-375 px-5 sm:px-8 lg:px-12">
    <div class="panel-heading mb-4">
      <LineIcon name="folder" class="size-4" /><h2>
        Proyectos destacados
      </h2><span
        class="ml-auto font-mono text-[10px] font-normal text-slate-600"
        >SELECTED_WORK / 06</span>
    </div>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        allProjects.map((project, index) => (
          <article
            class:list={[
              "group flex min-w-0 flex-col overflow-hidden rounded-lg border bg-linear-to-b from-[#0b1926] to-[#07111b] shadow-[0_8px_24px_rgba(0,0,0,.18)]",
              index < 2 ? "border-cyan-400/20" : "border-white/10",
            ]}
          >
            <button
              type="button"
              class="relative aspect-video cursor-zoom-in overflow-hidden border-b border-white/8 bg-black/30 p-2 text-left focus-visible:outline-2 focus-visible:outline-inset focus-visible:outline-cyan-400"
              data-project-image={project.image}
              data-project-title={project.title}
              aria-label={`Ampliar captura de ${project.title}`}
            >
              <img
                src={project.image}
                alt={`Vista de ${project.title}`}
                width="900"
                height="506"
                loading="lazy"
                decoding="async"
                class="h-full w-full rounded-sm object-cover object-top transition duration-300 group-hover:scale-[1.02]"
              />
              <span class="absolute bottom-3 right-3 flex items-center gap-1.5 rounded border border-white/15 bg-[#020810]/85 px-2 py-1 text-[9px] uppercase tracking-wider text-white opacity-100 backdrop-blur sm:opacity-0 sm:transition sm:group-hover:opacity-100">
                <LineIcon name="zoom" class="size-3.5 text-cyan-300" /> Ampliar
              </span>
            </button>
            <div class="flex flex-1 flex-col p-3">
              <>
                <div class="mb-1 flex items-start justify-between gap-2">
                  <>
                    <h3 class="text-sm font-bold text-white">
                      {project.title}
                    </h3>
                    <span class="font-mono text-[9px] text-slate-600">
                      0{index + 1}
                    </span>
                  </>
                </div>
                <p class="text-[11px] leading-4 text-slate-400">
                  {project.description}
                </p>
                <div class="mt-2 flex flex-wrap gap-1">
                  {project.stack.slice(0, 3).map((technology) => (
                    <span class="rounded bg-cyan-400/[.07] px-1.5 py-1 text-[9px] text-slate-300">
                      {technology}
                    </span>
                  ))}
                </div>
                <div class="mt-auto flex items-center gap-2 pt-3">
                  {project.url ? (
                    <a
                      href={project.url}
                      target="_blank"
                      rel="noreferrer"
                      class="inline-flex rounded border border-cyan-400/40 px-2 py-1.5 font-mono text-[9px] font-bold uppercase tracking-wider text-cyan-300 hover:bg-cyan-400/8 focus-visible:outline-2 focus-visible:outline-cyan-400"
                    >
                      Visitar web ↗
                    </a>
                  ) : (
                    <span class="inline-flex rounded border border-white/10 px-2 py-1.5 font-mono text-[9px] uppercase tracking-wider text-slate-500">
                      Privado
                    </span>
                  )}
                  <button
                    type="button"
                    data-project-image={project.image}
                    data-project-title={project.title}
                    class="font-mono text-[9px] uppercase text-slate-500 hover:text-cyan-300"
                  >
                    Ver captura
                  </button>
                </div>
              </>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<dialog
  data-image-dialog
  class="m-auto max-h-[94vh] w-[min(96vw,1500px)] max-w-none overflow-hidden rounded-lg border border-cyan-400/25 bg-[#030a11] p-0 text-white shadow-2xl backdrop:bg-black/85 backdrop:backdrop-blur-sm"
>
  <div
    class="flex items-center justify-between border-b border-white/10 px-4 py-3"
  >
    <p data-dialog-title class="text-sm font-semibold"></p><button
      data-dialog-close
      type="button"
      class="grid size-8 place-items-center rounded border border-white/10 text-lg text-slate-300 hover:border-cyan-400/30 hover:text-white"
      aria-label="Cerrar imagen">×</button>
  </div>
  <div class="max-h-[calc(94vh-57px)] overflow-auto bg-black/30 p-2 sm:p-4">
    <img
      data-dialog-image
      alt=""
      class="mx-auto h-auto max-h-[calc(94vh-90px)] max-w-full object-contain"
    />
  </div>
</dialog>

<script>
  const imageDialog = document.querySelector<HTMLDialogElement>(
    "[data-image-dialog]",
  );
  const dialogImage = imageDialog?.querySelector<HTMLImageElement>(
    "[data-dialog-image]",
  );
  const dialogTitle = imageDialog?.querySelector<HTMLElement>(
    "[data-dialog-title]",
  );
  const closeButton = imageDialog?.querySelector<HTMLButtonElement>(
    "[data-dialog-close]",
  );
  const imageTriggers = document.querySelectorAll<HTMLButtonElement>(
    "[data-project-image]",
  );

  imageTriggers.forEach((trigger) =>
    trigger.addEventListener("click", () => {
      const imageSource = trigger.dataset.projectImage;
      const projectTitle = trigger.dataset.projectTitle ?? "Proyecto";
      if (!imageDialog || !dialogImage || !imageSource) return;
      dialogImage.src = imageSource;
      dialogImage.alt = `Captura ampliada de ${projectTitle}`;
      if (dialogTitle) dialogTitle.textContent = projectTitle;
      imageDialog.showModal();
    }),
  );

  closeButton?.addEventListener("click", () => imageDialog?.close());
  imageDialog?.addEventListener("click", (event) => {
    if (event.target === imageDialog) imageDialog.close();
  });
</script>
