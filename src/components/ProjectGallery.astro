---
import { otherProjects } from "../data/projects";
import LineIcon from "./LineIcon.astro";
---

<section class="border-b border-white/8 py-8">
  <div class="mx-auto max-w-375 px-5 sm:px-8 lg:px-12">
    <div class="panel-heading mb-4">
      <LineIcon name="folder" class="size-4" /><h2>Otros proyectos</h2>
    </div>
    <div
      class="grid gap-px overflow-hidden rounded border border-white/8 bg-white/8 md:grid-cols-3"
    >
      {
        otherProjects.map((project, index) => (
          <a
            href={project.url}
            target="_blank"
            rel="noreferrer"
            class="group relative flex gap-3 bg-[#07111b] p-4 focus-visible:z-10 focus-visible:outline-2 focus-visible:outline-cyan-400"
          >
            <>
              <span class="absolute inset-x-0 top-0 h-px origin-left scale-x-0 bg-cyan-400 transition group-hover:scale-x-100" />
              <span class="font-mono text-[9px] text-cyan-300">
                0{index + 1}
              </span>
              <span class="min-w-0 flex-1">
                <>
                  <strong class="block text-xs text-white">
                    {project.title}
                  </strong>
                  <span class="mt-1 block text-[11px] leading-4 text-slate-400">
                    {project.description}
                  </span>
                  <span class="mt-2 block font-mono text-[9px] text-slate-500">
                    {project.stack}
                  </span>
                </>
              </span>
              <span class="text-xs text-cyan-300">↗</span>
            </>
          </a>
        ))
      }
    </div>
  </div>
</section>
